{
  "name": "ai-review-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Modular, plugin-based, event-driven, provider-agnostic Multi-Agent AI Code Review Platform.",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "turbo run build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {
    "@ai-review/orchestrator": "*",
    "@ai-review/shared": "*",
    "express": "^4.21.2",
    "lucide-react": "^1.31.0",
    "turbo": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.5.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "esbuild": "^0.25.0"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
