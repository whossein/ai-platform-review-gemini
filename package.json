{
  "name": "ai-review-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Modular, plugin-based, event-driven, provider-agnostic Multi-Agent AI Code Review Platform.",
  "type": "module",
  "main": "main.cjs",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "turbo run build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "desktop": "concurrently \"npm run start\" \"wait-on http://localhost:3000 && electron .\"",
    "build:desktop": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ai-review/orchestrator": "*",
    "@ai-review/shared": "*",
    "@ai-review/config": "*",
    "express": "^4.21.2",
    "lucide-react": "^1.31.0",
    "turbo": "^2.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.aireview.app",
    "productName": "AI Code Reviewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "apps/web/dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  }
}
