{
  "name": "@ai-review/context-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Build-once/share, minimized context: AST, imports/exports, dependency graph, changed/related symbols (ADR-0004).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ai-review/core": "*",
    "@ai-review/repository": "*",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0"
  }
}
